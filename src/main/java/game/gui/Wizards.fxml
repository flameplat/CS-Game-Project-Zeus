<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="362.0" prefWidth="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.Wizards">
   <children>
      <ImageView fx:id="mainImageView" fitHeight="362.0" fitWidth="900.0" layoutX="1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../resources/images/wizards/AllWizards.png" />
         </image>
      </ImageView>
      <StackPane layoutX="294.0" layoutY="299.0" prefHeight="27.0" prefWidth="200.0">
         <children>
            <ImageView fx:id="buttonImageView" fitHeight="65.0" fitWidth="311.0" pickOnBounds="true">
               <image>
                  <Image url="@../../../resources/images/buttons/3.png" />
               </image>
            </ImageView>
            <Label fx:id="mainLabel" alignment="CENTER" prefHeight="35.0" prefWidth="200.0" text="Mostafa, choose your wizard" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </StackPane>
      <HBox prefHeight="337.0" prefWidth="899.0">
         <children>
            <Rectangle fx:id="redWizardRectangle" arcHeight="5.0" arcWidth="5.0" fill="#ffffff00" height="361.0" onMouseClicked="#chooseRedWizard" stroke="#ffffff00" strokeType="INSIDE" width="181.0" />
            <Rectangle fx:id="greenWizardRectangle" arcHeight="5.0" arcWidth="5.0" fill="#ffffff00" height="361.0" onMouseClicked="#chooseGreenWizard" stroke="#ffffff00" strokeType="INSIDE" width="181.0" />
            <Rectangle fx:id="blueWizardRectangle" arcHeight="5.0" arcWidth="5.0" fill="#ffffff00" height="361.0" onMouseClicked="#chooseBlueWizard" stroke="#ffffff00" strokeType="INSIDE" width="181.0" />
            <Rectangle fx:id="magentaWizardRectangle" arcHeight="5.0" arcWidth="5.0" fill="#ffffff00" height="361.0" onMouseClicked="#chooseMagentaWizard" stroke="#ffffff00" strokeType="INSIDE" width="181.0" />
            <Rectangle fx:id="yellowWizardRectangle" arcHeight="5.0" arcWidth="5.0" fill="#ffffff00" height="361.0" onMouseClicked="#chooseYellowWizard" stroke="#ffffff00" strokeType="INSIDE" width="174.0" />
         </children>
      </HBox>
   </children>
</AnchorPane>
